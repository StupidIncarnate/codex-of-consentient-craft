# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# test artifacts
tests/tmp/
spike-tmp/
# Written by check-run-e2e-broker.ts as
# `${projectFolder.path}/.ward-playwright-report-${serverPort}.json`. The glob is load-bearing: the
# port suffix is what lets two browser walks run against one package at once, and an exact-name
# entry here would stop ignoring the ~400KB report each e2e run leaves behind when it is killed
# before its own cleanup.
.ward-playwright-report*.json


# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# E2E Test Results (but keep baseline snapshots)
/playwright-report
test-results
**/*-actual.png
**/*-diff.png
**/visual-reports/

# Keep baseline snapshots committed:
# **/*-snapshots/ - These ARE committed for team collaboration

