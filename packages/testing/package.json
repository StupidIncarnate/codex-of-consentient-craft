{
  "name": "@dungeonmaster/testing",
  "version": "0.1.0",
  "description": "Testing utilities and helpers for Dungeonmaster projects",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./register-mock": {
      "source": "./src/register-mock.ts",
      "types": "./dist/src/register-mock.d.ts",
      "import": "./dist/src/register-mock.js",
      "require": "./dist/src/register-mock.js"
    },
    "./brokers/network-record/playwright": {
      "source": "./src/brokers/network-record/playwright/network-record-playwright-broker.ts",
      "types": "./dist/src/brokers/network-record/playwright/network-record-playwright-broker.d.ts",
      "import": "./dist/src/brokers/network-record/playwright/network-record-playwright-broker.js",
      "require": "./dist/src/brokers/network-record/playwright/network-record-playwright-broker.js"
    },
    "./brokers/queue-metadata/read": {
      "source": "./src/brokers/queue-metadata/read/queue-metadata-read-broker.ts",
      "types": "./dist/src/brokers/queue-metadata/read/queue-metadata-read-broker.d.ts",
      "import": "./dist/src/brokers/queue-metadata/read/queue-metadata-read-broker.js",
      "require": "./dist/src/brokers/queue-metadata/read/queue-metadata-read-broker.js"
    },
    "./middleware/mantine-render": {
      "source": "./src/middleware/mantine-render/mantine-render-middleware.ts",
      "types": "./dist/src/middleware/mantine-render/mantine-render-middleware.d.ts",
      "import": "./dist/src/middleware/mantine-render/mantine-render-middleware.js",
      "require": "./dist/src/middleware/mantine-render/mantine-render-middleware.js"
    },
    "./middleware/child-process-mock": {
      "source": "./src/middleware/child-process-mock/child-process-mock-middleware.ts",
      "types": "./dist/src/middleware/child-process-mock/child-process-mock-middleware.d.ts",
      "import": "./dist/src/middleware/child-process-mock/child-process-mock-middleware.js",
      "require": "./dist/src/middleware/child-process-mock/child-process-mock-middleware.js"
    },
    "./transformers/quest-flow-observable-seed": {
      "source": "./src/transformers/quest-flow-observable-seed/quest-flow-observable-seed-transformer.ts",
      "types": "./dist/src/transformers/quest-flow-observable-seed/quest-flow-observable-seed-transformer.d.ts",
      "import": "./dist/src/transformers/quest-flow-observable-seed/quest-flow-observable-seed-transformer.js",
      "require": "./dist/src/transformers/quest-flow-observable-seed/quest-flow-observable-seed-transformer.js"
    },
    "./brokers": {
      "source": "./brokers.ts",
      "types": "./dist/brokers.d.ts",
      "import": "./dist/brokers.js",
      "require": "./dist/brokers.js"
    },
    "./jest-config-base": "./jest-config-base.js",
    "./jsdom-polyfills": "./src/jsdom-polyfills.cjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "ts-jest",
    "jest-config-base.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/src/startup/*.js 2>/dev/null || true",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "devDependencies": {
    "@dungeonmaster/browser": "*",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "typesVersions": {
    "*": {
      "register-mock": [
        "src/register-mock.ts"
      ],
      "brokers/network-record/playwright": [
        "dist/src/brokers/network-record/playwright/network-record-playwright-broker.d.ts"
      ],
      "brokers/queue-metadata/read": [
        "dist/src/brokers/queue-metadata/read/queue-metadata-read-broker.d.ts"
      ],
      "middleware/mantine-render": [
        "dist/src/middleware/mantine-render/mantine-render-middleware.d.ts"
      ],
      "middleware/child-process-mock": [
        "dist/src/middleware/child-process-mock/child-process-mock-middleware.d.ts"
      ],
      "transformers/quest-flow-observable-seed": [
        "dist/src/transformers/quest-flow-observable-seed/quest-flow-observable-seed-transformer.d.ts"
      ]
    }
  },
  "dependencies": {
    "@dungeonmaster/bin": "*",
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*",
    "tsx": "^4.0.0",
    "undici": "^7.21.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
