{
  "name": "@dungeonmaster/browser",
  "version": "0.1.0",
  "description": "Gateway package: everything the browser provides \u2014 globals and browser APIs",
  "sideEffects": false,
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "exports": {
    "./_test_/*": {
      "gateway-dist": "./dist/*/*.proxy.d.ts",
      "source": "./src/*/*.proxy.ts",
      "import": "./dist/*/*.proxy.js",
      "require": "./dist/*/*.proxy.js",
      "types": "./dist/*/*.proxy.d.ts"
    },
    "./*": {
      "gateway-dist": "./dist/*/*.d.ts",
      "source": "./src/*/*.ts",
      "import": "./dist/*/*.js",
      "require": "./dist/*/*.js",
      "types": "./dist/*/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*",
    "@types/node": "^24.0.15",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
