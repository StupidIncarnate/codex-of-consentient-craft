{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationMap": true,
    "declaration": true,
    "incremental": true,
    "tsBuildInfoFile": "./.ward/build.tsbuildinfo",
    "customConditions": [
      "gateway-dist",
      "source"
    ]
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.proxy.ts",
    "**/*.stub.ts",
    "**/*.harness.ts",
    "dist"
  ]
}
