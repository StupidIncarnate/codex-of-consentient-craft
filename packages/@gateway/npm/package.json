{
  "name": "@dungeonmaster/npm",
  "version": "0.1.0",
  "description": "Gateway package: one subpath per third-party npm package our code imports, named for it",
  "sideEffects": [
    "./src/testing-library__jest-dom/testing-library__jest-dom.ts",
    "./dist/testing-library__jest-dom/testing-library__jest-dom.js"
  ],
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.proxy": {
      "npm-own-source": "./src/*.proxy.ts",
      "gateway-dist": "./dist/*.proxy.d.ts",
      "source": "./src/*.proxy.ts",
      "types": "./dist/*.proxy.d.ts",
      "import": "./dist/*.proxy.js",
      "require": "./dist/*.proxy.js"
    },
    "./*.stub": {
      "npm-own-source": "./src/*.stub.ts",
      "gateway-dist": "./dist/*.stub.d.ts",
      "source": "./src/*.stub.ts",
      "types": "./dist/*.stub.d.ts",
      "import": "./dist/*.stub.js",
      "require": "./dist/*.stub.js"
    },
    "./*": {
      "npm-own-source": "./src/*/*.ts",
      "gateway-dist": "./dist/*/*.d.ts",
      "source": "./src/*/*.ts",
      "types": "./dist/*/*.d.ts",
      "import": "./dist/*/*.js",
      "require": "./dist/*/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@hono/node-ws": "^1.0.0",
    "@jest/globals": "^30.0.4",
    "@mantine/core": "^8.0.0",
    "@mantine/notifications": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tabler/icons-react": "^3.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.0.0",
    "@typescript-eslint/typescript-estree": "^8.35.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@xyflow/react": "^12.11.0",
    "debug": "^4.4.1",
    "elkjs": "^0.10.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-jest": "^29.0.1",
    "fast-xml-parser": "^5.6.0",
    "glob": "^10.3.10",
    "hono": "^4.0.0",
    "ioredis": "^5.7.0",
    "jest-mock": "^30.0.4",
    "minimatch": "^9.0.5",
    "msw": "^2.12.10",
    "pixelmatch": "^5.3.0",
    "pngjs": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.0",
    "rxjs": "^7.8.2",
    "semver": "^6.3.1",
    "tsx": "^4.0.0",
    "undici": "^7.21.0",
    "vite": "^6.0.0",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.0"
  },
  "peerDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.45.0",
    "@typescript-eslint/utils": "^8.35.1",
    "eslint": "^9.36.0",
    "typescript": "^5.8.3"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "@typescript-eslint/utils": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dungeonmaster/node": "*",
    "@dungeonmaster/testing": "*",
    "@types/node": "^24.0.15",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^6.2.7",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
