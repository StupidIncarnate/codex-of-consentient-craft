{
  "name": "@dungeonmaster/bin",
  "version": "0.1.0",
  "description": "Gateway package: programs installed on the machine, run through spawn",
  "sideEffects": false,
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "exports": {
    "./*.proxy": {
      "bin-own-source": "./src/*.proxy.ts",
      "gateway-dist": "./dist/*.proxy.d.ts",
      "source": "./src/*.proxy.ts",
      "import": "./dist/*.proxy.js",
      "require": "./dist/*.proxy.js",
      "types": "./dist/*.proxy.d.ts"
    },
    "./*.stub": {
      "bin-own-source": "./src/*.stub.ts",
      "gateway-dist": "./dist/*.stub.d.ts",
      "source": "./src/*.stub.ts",
      "import": "./dist/*.stub.js",
      "require": "./dist/*.stub.js",
      "types": "./dist/*.stub.d.ts"
    },
    "./*": {
      "bin-own-source": "./src/*/*.ts",
      "gateway-dist": "./dist/*/*.d.ts",
      "source": "./src/*/*.ts",
      "import": "./dist/*/*.js",
      "require": "./dist/*/*.js",
      "types": "./dist/*/*.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@dungeonmaster/node": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*",
    "@types/node": "^24.0.15",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
