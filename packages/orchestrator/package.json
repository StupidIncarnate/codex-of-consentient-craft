{
  "name": "@dungeonmaster/orchestrator",
  "version": "0.1.0",
  "description": "Agent orchestration for Dungeonmaster quest execution",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./brokers": {
      "source": "./brokers.ts",
      "import": "./dist/brokers.js",
      "require": "./dist/brokers.js",
      "types": "./dist/brokers.d.ts"
    },
    "./testing": {
      "source": "./testing.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    },
    "./*.proxy": {
      "source": "./src/*.proxy.ts",
      "import": "./dist/*.proxy.js",
      "require": "./dist/*.proxy.js",
      "types": "./dist/*.proxy.d.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts",
      "import": "./dist/*.stub.js",
      "require": "./dist/*.stub.js",
      "types": "./dist/*.stub.d.ts"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/startup/*.js 2>/dev/null || true",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "test:unit": "jest --testPathIgnorePatterns='\\.integration\\.'",
    "lint": "dungeonmaster-ward --only lint",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@dungeonmaster/config": "*",
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*",
    "@dungeonmaster/shared": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*"
  }
}
