{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./.ward/build.tsbuildinfo",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "declarationMap": true
  },
  "exclude": [
    "**/*.test.ts", "**/*.test.tsx", "**/*.proxy.ts", "**/*.stub.ts",
    "**/*.harness.ts", "test/**", "src/.test-tmp/**", "src/_lint-testbed/**"
  ]
}
