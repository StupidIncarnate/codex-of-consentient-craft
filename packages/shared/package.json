{
  "name": "@dungeonmaster/shared",
  "version": "0.1.0",
  "description": "Shared contracts and utilities for Dungeonmaster packages",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "exports": {
    "./testing": {
      "source": "./testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js"
    },
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    },
    "./*": {
      "source": "./src/*/*.ts",
      "types": "./dist/src/*/*.d.ts",
      "import": "./dist/src/*/*.js",
      "require": "./dist/src/*/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/startup/*.js 2>/dev/null || true",
    "build:clean": "rm -rf dist && npm run build",
    "test": "dungeonmaster-ward --only test",
    "test:unit": "jest --testPathIgnorePatterns='\\.integration\\.'",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "keywords": [
    "dungeonmaster",
    "contracts",
    "zod",
    "validation",
    "typescript"
  ],
  "dependencies": {
    "@dungeonmaster/bin": "*",
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
