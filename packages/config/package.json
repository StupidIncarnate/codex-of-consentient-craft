{
  "name": "@dungeonmaster/config",
  "version": "0.1.0",
  "description": "Configuration parser and resolver for Dungeonmaster architecture lint rules",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./contracts": {
      "source": "./contracts.ts",
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.js"
    },
    "./*.proxy": {
      "source": "./src/*.proxy.ts",
      "types": "./dist/*.proxy.d.ts",
      "import": "./dist/*.proxy.js",
      "require": "./dist/*.proxy.js"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts",
      "types": "./dist/*.stub.d.ts",
      "import": "./dist/*.stub.js",
      "require": "./dist/*.stub.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/startup/*.js 2>/dev/null || true",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "test:unit": "jest --testPathIgnorePatterns='\\.integration\\.'",
    "lint": "dungeonmaster-ward --only lint",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "ward": "dungeonmaster-ward"
  },
  "keywords": [
    "dungeonmaster",
    "config",
    "lint",
    "architecture"
  ],
  "dependencies": {
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*",
    "@dungeonmaster/shared": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
