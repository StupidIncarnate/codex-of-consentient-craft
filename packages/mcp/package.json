{
  "name": "@dungeonmaster/mcp",
  "version": "0.1.0",
  "description": "MCP server for discovering utilities, brokers, and standards across the codebase",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    },
    "./brokers": {
      "source": "./src/brokers/brokers.ts",
      "types": "./dist/src/brokers/brokers.d.ts",
      "import": "./dist/src/brokers/brokers.js",
      "require": "./dist/src/brokers/brokers.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "dungeonmaster-mcp": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "cp src/statics/folder-constraints/*.md dist/src/statics/folder-constraints/ && chmod +x dist/src/index.js dist/src/startup/*.js 2>/dev/null || true",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='\\.integration\\.'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "dev": "tsx watch src/index.ts",
    "mcp:dev": "DANGEROUSLY_OMIT_AUTH=true npx @modelcontextprotocol/inspector@2.4.0 ./start-server.sh"
  },
  "dependencies": {
    "@dungeonmaster/eslint-plugin": "*",
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*",
    "@dungeonmaster/orchestrator": "*",
    "@dungeonmaster/shared": "*",
    "@dungeonmaster/ward": "*",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
