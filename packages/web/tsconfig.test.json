{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "isolatedModules": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "../../@types"
    ]
  },
  "include": ["src"]
}
