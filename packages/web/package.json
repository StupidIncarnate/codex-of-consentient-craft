{
  "name": "@dungeonmaster/web",
  "version": "0.1.0",
  "description": "Web UI for Dungeonmaster quest management",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node ../../scripts/prune-vite-caches.mjs && vite",
    "dev:no-watch": "node ../../scripts/prune-vite-caches.mjs && E2E_NO_WATCH=1 vite",
    "build": "vite build",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "preview": "node ../../scripts/prune-vite-caches.mjs && vite preview",
    "test": "dungeonmaster-ward --only test",
    "test:unit": "jest --testPathIgnorePatterns='\\.integration\\.'",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@dungeonmaster/browser": "*",
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*",
    "@dungeonmaster/shared": "*",
    "@mantine/core": "^8.0.0",
    "@mantine/notifications": "^8.0.0",
    "@xyflow/react": "^12.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dungeonmaster/bin": "*",
    "@dungeonmaster/hydration-recipes": "*",
    "@dungeonmaster/testing": "*",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "postcss": "^8.0.0",
    "postcss-preset-mantine": "^1.0.0",
    "typescript": "^5.3.0",
    "undici": "^7.21.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    }
  }
}
