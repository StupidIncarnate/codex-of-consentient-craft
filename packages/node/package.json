{
  "name": "@dungeonmaster/node",
  "version": "0.1.0",
  "description": "Gateway package: everything the Node runtime provides, modules and globals alike",
  "exports": {
    "./path": {
      "source": "./path/index.ts",
      "require": "./dist/path/index.js",
      "import": "./dist/path/index.js",
      "types": "./dist/path/index.d.ts"
    },
    "./events": {
      "source": "./events/index.ts",
      "require": "./dist/events/index.js",
      "import": "./dist/events/index.js",
      "types": "./dist/events/index.d.ts"
    },
    "./url": {
      "source": "./url/index.ts",
      "require": "./dist/url/index.js",
      "import": "./dist/url/index.js",
      "types": "./dist/url/index.d.ts"
    },
    "./util": {
      "source": "./util/index.ts",
      "require": "./dist/util/index.js",
      "import": "./dist/util/index.js",
      "types": "./dist/util/index.d.ts"
    },
    "./testing": {
      "source": "./testing/index.ts",
      "require": "./dist/testing/index.js",
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*",
    "@types/node": "^24.0.15",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
