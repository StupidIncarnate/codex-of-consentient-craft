{
  "name": "@dungeonmaster/ward",
  "version": "0.1.0",
  "description": "Structured lint/typecheck/test runner with tiered drill-down output",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "bin": {
    "dungeonmaster-ward": "./dist/bin/ward-entry.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/src/startup/*.js dist/bin/ward-entry.js 2>/dev/null || true",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "lint": "dungeonmaster-ward --only lint",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "ward": "dungeonmaster-ward"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "keywords": [
    "ward",
    "lint",
    "typecheck",
    "test",
    "runner"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@dungeonmaster/testing": "*"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@dungeonmaster/bin": "*",
    "@dungeonmaster/config": "*",
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*",
    "@dungeonmaster/shared": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    }
  }
}
