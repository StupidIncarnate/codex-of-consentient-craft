{
  "name": "@dungeonmaster/siegelense",
  "version": "0.1.0",
  "description": "siegelense package",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "exports": {
    "./contracts": {
      "source": "./contracts.ts",
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.js"
    },
    "./statics": {
      "source": "./statics.ts",
      "types": "./dist/statics.d.ts",
      "import": "./dist/statics.js",
      "require": "./dist/statics.js"
    },
    "./errors": {
      "source": "./errors.ts",
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.js"
    },
    "./guards": {
      "source": "./guards.ts",
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.js",
      "require": "./dist/guards.js"
    },
    "./brokers": {
      "source": "./brokers.ts",
      "types": "./dist/brokers.d.ts",
      "import": "./dist/brokers.js",
      "require": "./dist/brokers.js"
    },
    "./startup": {
      "source": "./startup.ts",
      "types": "./dist/startup.d.ts",
      "import": "./dist/startup.js",
      "require": "./dist/startup.js"
    },
    "./flows": {
      "source": "./flows.ts",
      "types": "./dist/flows.d.ts",
      "import": "./dist/flows.js",
      "require": "./dist/flows.js"
    },
    "./state": {
      "source": "./state.ts",
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "require": "./dist/state.js"
    },
    "./testing": {
      "source": "./testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@dungeonmaster/bin": "*",
    "@dungeonmaster/cli": "*",
    "@dungeonmaster/config": "*",
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*",
    "@dungeonmaster/shared": "*",
    "pixelmatch": "^5.3.0",
    "pngjs": "^6.0.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@playwright/test": "^1.58.2"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.11.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
