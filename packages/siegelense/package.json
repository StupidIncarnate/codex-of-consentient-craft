{
  "name": "@dungeonmaster/siegelense",
  "version": "0.1.0",
  "description": "siegelense package",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    },
    "./brokers": {
      "source": "./src/brokers/brokers.ts",
      "types": "./dist/src/brokers/brokers.d.ts",
      "import": "./dist/src/brokers/brokers.js",
      "require": "./dist/src/brokers/brokers.js"
    },
    "./contracts": {
      "source": "./src/contracts/contracts.ts",
      "types": "./dist/src/contracts/contracts.d.ts",
      "import": "./dist/src/contracts/contracts.js",
      "require": "./dist/src/contracts/contracts.js"
    },
    "./errors": {
      "source": "./src/errors/errors.ts",
      "types": "./dist/src/errors/errors.d.ts",
      "import": "./dist/src/errors/errors.js",
      "require": "./dist/src/errors/errors.js"
    },
    "./flows": {
      "source": "./src/flows/flows.ts",
      "types": "./dist/src/flows/flows.d.ts",
      "import": "./dist/src/flows/flows.js",
      "require": "./dist/src/flows/flows.js"
    },
    "./guards": {
      "source": "./src/guards/guards.ts",
      "types": "./dist/src/guards/guards.d.ts",
      "import": "./dist/src/guards/guards.js",
      "require": "./dist/src/guards/guards.js"
    },
    "./startup": {
      "source": "./src/startup/startup.ts",
      "types": "./dist/src/startup/startup.d.ts",
      "import": "./dist/src/startup/startup.js",
      "require": "./dist/src/startup/startup.js"
    },
    "./state": {
      "source": "./src/state/state.ts",
      "types": "./dist/src/state/state.d.ts",
      "import": "./dist/src/state/state.js",
      "require": "./dist/src/state/state.js"
    },
    "./statics": {
      "source": "./src/statics/statics.ts",
      "types": "./dist/src/statics/statics.d.ts",
      "import": "./dist/src/statics/statics.js",
      "require": "./dist/src/statics/statics.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@dungeonmaster/bin": "*",
    "@dungeonmaster/cli": "*",
    "@dungeonmaster/config": "*",
    "@dungeonmaster/load-balancer": "*",
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*",
    "@dungeonmaster/shared": "*"
  },
  "peerDependencies": {
    "@playwright/test": "^1.58.2"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.11.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
