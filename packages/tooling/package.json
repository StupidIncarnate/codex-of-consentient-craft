{
  "name": "@dungeonmaster/tooling",
  "version": "1.0.0",
  "description": "Development tools for code quality analysis",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./*.proxy": {
      "source": "./src/*.proxy.ts"
    },
    "./*.stub": {
      "source": "./src/*.stub.ts"
    }
  },
  "bin": {
    "detect-duplicate-primitives": "./dist/bin/detect-duplicate-primitives.js",
    "adapter-census": "./dist/bin/adapter-census.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/src/startup/*.js 2>/dev/null || true",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "test:unit": "jest --testPathIgnorePatterns='\\.integration\\.'",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward",
    "detect-duplicates": "tsx src/index.ts",
    "adapter-census": "tsx --conditions=source bin/adapter-census.ts"
  },
  "dependencies": {
    "@dungeonmaster/node": "*",
    "@dungeonmaster/npm": "*",
    "@dungeonmaster/shared": "*",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*",
    "@types/node": "^20.11.0"
  }
}
