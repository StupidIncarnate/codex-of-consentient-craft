{
  "name": "@dungeonmaster/hydration-recipes",
  "version": "0.1.0",
  "description": "hydration-recipes package",
  "imports": {
    "#gateway/npm/*": "@dungeonmaster/npm/*",
    "#gateway/node/*": "@dungeonmaster/node/*",
    "#gateway/browser/*": "@dungeonmaster/browser/*",
    "#gateway/bin/*": "@dungeonmaster/bin/*"
  },
  "private": true,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./contracts": {
      "source": "./contracts.ts",
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.js"
    },
    "./statics": {
      "source": "./statics.ts",
      "types": "./dist/statics.d.ts",
      "import": "./dist/statics.js",
      "require": "./dist/statics.js"
    },
    "./brokers": {
      "source": "./brokers.ts",
      "types": "./dist/brokers.d.ts",
      "import": "./dist/brokers.js",
      "require": "./dist/brokers.js"
    },
    "./transformers": {
      "source": "./transformers.ts",
      "types": "./dist/transformers.d.ts",
      "import": "./dist/transformers.js",
      "require": "./dist/transformers.js"
    },
    "./responders": {
      "source": "./responders.ts",
      "types": "./dist/responders.d.ts",
      "import": "./dist/responders.js",
      "require": "./dist/responders.js"
    },
    "./testing": {
      "source": "./testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist .ward/build.tsbuildinfo && npm run build",
    "test": "dungeonmaster-ward --only test",
    "typecheck": "dungeonmaster-ward --only typecheck",
    "lint": "dungeonmaster-ward --only lint",
    "ward": "dungeonmaster-ward"
  },
  "dependencies": {
    "@dungeonmaster/hydration": "*",
    "@dungeonmaster/node": "*",
    "@dungeonmaster/orchestrator": "*",
    "@dungeonmaster/shared": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dungeonmaster/testing": "*",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
